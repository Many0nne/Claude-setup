{
  "permissions": {
    "allow": [
      "Read(~/.claude/**)"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -File \"$env:USERPROFILE\\.claude\\git-safe\\hook.ps1\"",
            "shell": "powershell",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$env:USERPROFILE\\.claude\\hooks\\lint-on-edit.ps1\"",
            "shell": "powershell",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$env:USERPROFILE\\.claude\\hooks\\stop-validate.ps1\"",
            "shell": "powershell",
            "timeout": 180
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$env:USERPROFILE\\.claude\\hooks\\worktree-reminder.ps1\"",
            "shell": "powershell",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "workflowKeywordTriggerEnabled": false,
  "enabledPlugins": {},
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "awaySummaryEnabled": false,
  "autoUpdatesChannel": "latest",
  "theme": "auto",
  "autoCompactEnabled": false,
  "autoContinueAtUsageLimit": false,
  "agentPushNotifEnabled": true,
  "switchModelsOnFlag": false
}

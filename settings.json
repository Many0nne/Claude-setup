{
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -File \"$env:USERPROFILE\\.claude\\git-safe\\hook.ps1\"",
            "shell": "powershell",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$env:USERPROFILE\\.claude\\hooks\\worktree-reminder.ps1\"",
            "shell": "powershell",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "pwsh -NoProfile -File C:/Users/tbarillon/.claude/statusline.ps1"
  },
  "enabledPlugins": {},
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    }
  },
  "awaySummaryEnabled": false,
  "autoUpdatesChannel": "latest",
  "theme": "auto",
  "autoCompactEnabled": false,
  "autoContinueAtUsageLimit": false,
  "agentPushNotifEnabled": true
}
